<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>msa</artifactId>
        <groupId>org.thingsboard.mqtt-broker</groupId>
        <version>2.5.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.thingsboard.mqtt-broker.msa</groupId>
    <artifactId>tbmq-lite</artifactId>
    <packaging>pom</packaging>

    <name>TBMQ Lite</name>

    <!--
        Phase 1 skeleton: this module holds no code yet. It only proves, through the Enforcer
        rule below, that the application can be assembled without the cluster infrastructure.
        The image is added in Phase 4.
        lite-tests takes its classpath from this module, so its dependencies are declared only here.
    -->

    <properties>
        <main.dir>${basedir}/../..</main.dir>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.thingsboard.mqtt-broker</groupId>
            <artifactId>application</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.thingsboard.mqtt-broker.common</groupId>
                    <artifactId>queue-kafka</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.thingsboard.mqtt-broker.common</groupId>
                    <artifactId>cache-redis</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.thingsboard.mqtt-broker</groupId>
            <artifactId>dao-rocksdb</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- the ban list is defined once, in the root pom's pluginManagement -->
                        <id>ban-cluster-infrastructure</id>
                        <phase>validate</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
