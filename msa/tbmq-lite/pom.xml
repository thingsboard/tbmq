<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>msa</artifactId>
        <groupId>org.thingsboard.mqtt-broker</groupId>
        <version>2.5.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.thingsboard.mqtt-broker.msa</groupId>
    <artifactId>tbmq-lite</artifactId>
    <packaging>jar</packaging>

    <name>TBMQ Lite</name>

    <!--
        The Lite broker: the application without queue-kafka, cache-redis and the SQL infrastructure, plus dao-rocksdb.
        The Enforcer rules below keep that classpath free of the cluster and SQL infrastructure.
        The module's own jar is empty. The runnable broker jar, target/tbmq-lite-<version>-boot.jar, is built only with
        -Ddockerfile.skip=false (the yarn build on, so that the UI is inside it) and is the input of the image,
        together with the files of docker/, which are copied to target/ as they are.
        lite-tests takes its classpath from this module, so the dependencies are declared only here.

        Build the image with -am and the yarn build on (no -P '!yarn-build'):
            mvn -o -pl msa/tbmq-lite -am package -DskipTests -Dlicense.skip=true -Ddockerfile.skip=false
        Without -am the application modules come from the SNAPSHOT jars in ~/.m2, which can be stale, and the image
        silently ships old code. LiteImageSmokeTest must be green on that exact image before it is pushed.
    -->

    <properties>
        <main.dir>${basedir}/../..</main.dir>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.thingsboard.mqtt-broker</groupId>
            <artifactId>application</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.thingsboard.mqtt-broker</groupId>
                    <artifactId>dao-sql</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.thingsboard.mqtt-broker.common</groupId>
                    <artifactId>queue-kafka</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.thingsboard.mqtt-broker.common</groupId>
                    <artifactId>cache-redis</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.thingsboard.mqtt-broker</groupId>
            <artifactId>dao-rocksdb</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-docker-lite-files</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}</outputDirectory>
                            <resources>
                                <!-- the scripts and logback.xml are shipped byte for byte, so only the Dockerfile is filtered -->
                                <resource>
                                    <directory>docker</directory>
                                    <filtering>false</filtering>
                                    <excludes>
                                        <exclude>Dockerfile</exclude>
                                    </excludes>
                                </resource>
                                <resource>
                                    <directory>docker</directory>
                                    <filtering>true</filtering>
                                    <includes>
                                        <include>Dockerfile</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!--
                        An execution of its own: the root pom's default one stays skipped here, and it would also run
                        build-info, whose file for this module would hide the application's.
                    -->
                    <execution>
                        <id>lite-boot-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <skip>${dockerfile.skip}</skip>
                            <mainClass>org.thingsboard.mqtt.broker.ThingsboardMqttBrokerApplication</mainClass>
                            <classifier>boot</classifier>
                            <layout>ZIP</layout>
                            <!-- a plain jar for java -jar, without the launch script of the installation packages -->
                            <executable>false</executable>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!--
                    Declared after spring-boot-maven-plugin: both run in the package phase, in the order of the plugins,
                    and the image needs the repackaged boot jar and the files copied to target/ (the Docker context).
                    The Dockerfile is filtered only for the project version; the image is tagged with the version
                    and never with latest (the default tag of the build goal).
                -->
                <groupId>com.spotify</groupId>
                <artifactId>dockerfile-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>build-docker-image</id>
                        <phase>package</phase>
                        <goals>
                            <goal>build</goal>
                        </goals>
                        <configuration>
                            <skip>${dockerfile.skip}</skip>
                            <repository>${docker.repo}/tbmq-lite</repository>
                            <tag>${project.version}</tag>
                            <verbose>true</verbose>
                            <googleContainerRegistryEnabled>false</googleContainerRegistryEnabled>
                            <contextDirectory>${project.build.directory}</contextDirectory>
                            <pullNewerImage>${dockerfile.pullNewerImage}</pullNewerImage>
                            <noCache>true</noCache>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- the ban list is defined once, in the root pom's pluginManagement -->
                        <id>ban-cluster-infrastructure</id>
                        <phase>validate</phase>
                    </execution>
                    <execution>
                        <id>ban-sql-infrastructure</id>
                        <phase>validate</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <!--
                The inherited profile pushes the image for amd64 and arm64 and tags latest unconditionally. Here both of its
                executions are switched off and docker/push-multiarch.sh runs instead: the version tag always, latest only
                for a plain release version, so that a pre-release (-beta, -rc1) never moves latest.
                The push rebuilds the image from the same target/ boot jar, so build it first with -am and the yarn build
                on (mvn -o -pl msa/tbmq-lite -am package -DskipTests -Dlicense.skip=true -Ddockerfile.skip=false) and run
                LiteImageSmokeTest on that exact image before pushing.
            -->
            <id>push-docker-amd-arm-images</id>
            <activation>
                <property>
                    <name>push-docker-amd-arm-images</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>push-latest-docker-amd-arm-images</id>
                                <phase>none</phase>
                            </execution>
                            <execution>
                                <id>push-version-docker-amd-arm-images</id>
                                <phase>none</phase>
                            </execution>
                            <execution>
                                <id>push-lite-docker-amd-arm-images</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <workingDirectory>${project.build.directory}</workingDirectory>
                                    <arguments>
                                        <argument>push-multiarch.sh</argument>
                                        <argument>${docker.repo}/tbmq-lite</argument>
                                        <argument>${project.version}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
