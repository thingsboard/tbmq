<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>msa</artifactId>
        <groupId>org.thingsboard.mqtt-broker</groupId>
        <version>2.5.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.thingsboard.mqtt-broker.msa</groupId>
    <artifactId>tbmq-lite</artifactId>
    <packaging>pom</packaging>

    <name>TBMQ Lite</name>

    <!--
        Phase 1 skeleton: this module holds no code yet. It only proves, through the Enforcer
        rule below, that the application can be assembled without the cluster infrastructure.
        dao-rocksdb joins the dependencies in Phase 2 and the image in Phase 4.
        org.hibernate.orm:hibernate-core and org.postgresql:postgresql join the ban list in Phase 3.
    -->

    <properties>
        <main.dir>${basedir}/../..</main.dir>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.thingsboard.mqtt-broker</groupId>
            <artifactId>application</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.thingsboard.mqtt-broker.common</groupId>
                    <artifactId>queue-kafka</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.thingsboard.mqtt-broker.common</groupId>
                    <artifactId>cache-redis</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ban-cluster-infrastructure</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.apache.kafka:kafka-clients</exclude>
                                        <exclude>redis.clients:jedis</exclude>
                                        <exclude>io.lettuce:lettuce-core</exclude>
                                        <exclude>org.springframework.data:spring-data-redis</exclude>
                                        <exclude>com.bucket4j:bucket4j_jdk17-jedis</exclude>
                                        <exclude>com.bucket4j:bucket4j_jdk17-redis-common</exclude>
                                    </excludes>
                                    <message>tbmq-lite must not pull in the cluster infrastructure (Kafka, Redis)</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
