<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.thingsboard.mqtt-broker</groupId>
        <version>2.5.0-SNAPSHOT</version>
        <artifactId>mqtt-broker</artifactId>
    </parent>
    <artifactId>lite-tests</artifactId>
    <packaging>jar</packaging>

    <name>TBMQ Lite Tests</name>

    <!--
        Runs tests on a Lite classpath: the application and dao-rocksdb, without queue-kafka and cache-redis.
        It holds no main code and is never installed or deployed.
    -->

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <main.dir>${basedir}/..</main.dir>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.thingsboard.mqtt-broker</groupId>
            <artifactId>application</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.thingsboard.mqtt-broker.common</groupId>
                    <artifactId>queue-kafka</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.thingsboard.mqtt-broker.common</groupId>
                    <artifactId>cache-redis</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.thingsboard.mqtt-broker</groupId>
            <artifactId>dao-rocksdb</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <spring.config.name>thingsboard-mqtt-broker</spring.config.name>
                        <tbmq.openapi.spec.path>${project.basedir}/../api/openapi.json</tbmq.openapi.spec.path>
                    </systemPropertyVariables>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*TestSuite.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ban-cluster-infrastructure</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.apache.kafka:kafka-clients</exclude>
                                        <exclude>redis.clients:jedis</exclude>
                                        <exclude>io.lettuce:lettuce-core</exclude>
                                        <exclude>org.springframework.data:spring-data-redis</exclude>
                                        <exclude>com.bucket4j:bucket4j_jdk17-jedis</exclude>
                                        <exclude>com.bucket4j:bucket4j_jdk17-redis-common</exclude>
                                    </excludes>
                                    <message>lite-tests must not pull in the cluster infrastructure (Kafka, Redis)</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
