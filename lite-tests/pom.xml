<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.thingsboard.mqtt-broker</groupId>
        <version>2.5.0-SNAPSHOT</version>
        <artifactId>mqtt-broker</artifactId>
    </parent>
    <artifactId>lite-tests</artifactId>
    <packaging>jar</packaging>

    <name>TBMQ Lite Tests</name>

    <!--
        Runs tests on a Lite classpath, taken from msa/tbmq-lite: the application and dao-rocksdb, without
        queue-kafka, cache-redis and the SQL infrastructure. It holds no main code and is never installed or deployed.
    -->

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <main.dir>${basedir}/..</main.dir>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
    </properties>

    <dependencies>
        <dependency>
            <!-- the classpath the standalone image ships: application without queue-kafka and cache-redis, plus dao-rocksdb -->
            <groupId>org.thingsboard.mqtt-broker.msa</groupId>
            <artifactId>tbmq-lite</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <!--
                The application's integration and controller tests, without the cluster test infrastructure.
                Its transitive dependencies are the application's own, queue-kafka and cache-redis among them:
                tbmq-lite above already brings the Lite ones.
            -->
            <groupId>org.thingsboard.mqtt-broker</groupId>
            <artifactId>application</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <!-- the shared DeviceMsgService contract suite, without dao's test configuration -->
            <groupId>org.thingsboard.mqtt-broker</groupId>
            <artifactId>dao</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <classifier>lite-tests</classifier>
            <scope>test</scope>
        </dependency>
        <!-- the application's test dependencies, except Kafka's test container -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.jodah</groupId>
            <artifactId>concurrentunit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.takari.junit</groupId>
            <artifactId>takari-cpsuite</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.thingsboard.mqtt-broker</groupId>
            <artifactId>netty-mqtt</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock.integrations.testcontainers</groupId>
            <artifactId>wiremock-testcontainers-module</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.hivemq</groupId>
            <artifactId>hivemq-mqtt-client</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.paho</groupId>
            <artifactId>org.eclipse.paho.client.mqttv3</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.paho</groupId>
            <artifactId>org.eclipse.paho.mqttv5.client</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <spring.config.name>thingsboard-mqtt-broker</spring.config.name>
                        <tbmq.openapi.spec.path>${project.basedir}/../api/openapi.json</tbmq.openapi.spec.path>
                        <tbmq.openapi-lite.spec.path>${project.basedir}/../api/openapi-lite.json</tbmq.openapi-lite.spec.path>
                        <tbmq.fixtures.schema-1.path>${project.basedir}/../dao-rocksdb/src/test/resources/fixtures/schema-1/db</tbmq.fixtures.schema-1.path>
                        <tbmq.lite.start-script>${project.basedir}/../msa/tbmq-lite/docker/start-tbmq-lite.sh</tbmq.lite.start-script>
                        <tbmq.lite.push-script>${project.basedir}/../msa/tbmq-lite/docker/push-multiarch.sh</tbmq.lite.push-script>
                    </systemPropertyVariables>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*TestSuite.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- the ban list is defined once, in the root pom's pluginManagement -->
                        <id>ban-cluster-infrastructure</id>
                        <phase>validate</phase>
                    </execution>
                    <execution>
                        <!-- test scope included: no SQL class may reach a Lite test either -->
                        <id>ban-sql-infrastructure</id>
                        <phase>validate</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- inherited from the root pom for the modules that compile protos: this one has none -->
                        <id>copy-protoc</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <!--
                            The classpath the standalone image ships, which LiteBrokerProcess starts the broker on. The test
                            classpath would make beans of the test-jars' @Service and @Component classes, since the
                            application scans its whole package.
                        -->
                        <id>lite-runtime-classpath</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>build-classpath</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <excludeTypes>pom</excludeTypes>
                            <outputFile>${project.build.directory}/lite-runtime-classpath.txt</outputFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
